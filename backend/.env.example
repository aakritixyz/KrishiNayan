# Copy to backend/.env for local development. Never commit backend/.env.

# Database (optional; defaults to backend/storage/krishinayan.db)
# KRISHINAYAN_DATABASE_URL=sqlite:///./storage/krishinayan.db

# Mark production deployments explicitly.
KRISHINAYAN_ENV=development

# REQUIRED for any public deployment: use a long random secret.
KRISHINAYAN_JWT_SECRET=replace-with-a-long-random-secret

# Demo institutional account (OFF by default).
# Enable only for a controlled local/hackathon demo and choose your own credentials.
KRISHINAYAN_ENABLE_DEMO_OFFICER=false
KRISHINAYAN_DEMO_OFFICER_ID=YOUR-INSTITUTION-ID
KRISHINAYAN_DEMO_OFFICER_PASSWORD=replace-with-12-plus-character-password
KRISHINAYAN_DEMO_OFFICER_NAME=District Agriculture Officer
KRISHINAYAN_DEMO_ORGANISATION=District Agriculture Office
KRISHINAYAN_DEMO_DESIGNATION=Agriculture Officer
KRISHINAYAN_DEMO_STATE=Maharashtra
KRISHINAYAN_DEMO_DISTRICT=Pune

# Optional services
# ANTHROPIC_API_KEY=
# KRISHINAYAN_MODEL_PATH=

# Comma-separated deployed frontend origins allowed by CORS.
# FRONTEND_ORIGINS=https://your-frontend.vercel.app
