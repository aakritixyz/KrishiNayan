# Copy to backend/.env for local development. Never commit backend/.env.

# Database (optional; defaults to backend/storage/krishinayan.db)
# KRISHINAYAN_DATABASE_URL=sqlite:///./storage/krishinayan.db
# Production example:
# KRISHINAYAN_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# Mark production deployments explicitly.
KRISHINAYAN_ENV=development
KRISHINAYAN_LOG_LEVEL=INFO

KRISHINAYAN_JWT_SECRET=krishinayan-local-demo-secret-change-later

KRISHINAYAN_ENABLE_DEMO_OFFICER=true
KRISHINAYAN_DEMO_OFFICER_ID=MH-PUNE-AGRI-01
KRISHINAYAN_DEMO_OFFICER_PASSWORD=Krishi@Demo123
KRISHINAYAN_DEMO_OFFICER_NAME=District Agriculture Officer
KRISHINAYAN_DEMO_OFFICER_ORGANISATION=District Agriculture Office
KRISHINAYAN_DEMO_OFFICER_DESIGNATION=Agriculture Officer
KRISHINAYAN_DEMO_OFFICER_STATE=Maharashtra
KRISHINAYAN_DEMO_OFFICER_DISTRICT=Pune

# Optional services
# ANTHROPIC_API_KEY=
# KRISHINAYAN_MODEL_PATH=
# KRISHINAYAN_ENABLE_GRADCAM=true
# KRISHINAYAN_STORAGE_BACKEND=local
# KRISHINAYAN_UPLOAD_DIR=./uploads

# Supabase Storage (optional production image storage)
# KRISHINAYAN_STORAGE_BACKEND=supabase
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_STORAGE_BUCKET=crop-scans
# SUPABASE_STORAGE_PUBLIC=false

# Rate-limit bypass for tests only.
# KRISHINAYAN_DISABLE_RATE_LIMIT=false

# Comma-separated deployed frontend origins allowed by CORS.
# FRONTEND_ORIGINS=https://your-frontend.vercel.app
