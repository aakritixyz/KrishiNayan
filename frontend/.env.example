# Local development can omit this; the app defaults to http://127.0.0.1:8000.
# Set this on Vercel/production to your deployed FastAPI backend URL.
NEXT_PUBLIC_API_BASE_URL=https://your-backend.example.com

# Optional: enable the PWA service worker while testing locally.
# Keep this off unless you are specifically checking offline/cache behavior.
NEXT_PUBLIC_ENABLE_OFFLINE_SW=false
